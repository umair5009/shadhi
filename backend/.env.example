# ─── Runtime ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# Local dev DB started with `npm run db`, a local MongoDB install, or MongoDB Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017/shadi_hall

# ─── Auth ───────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30
# Set to true in production (HTTPS only cookies)
COOKIE_SECURE=false

# ─── Web app ────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Used to build password reset links
APP_URL=http://localhost:5173
# Number of reverse proxies in front of the API (0 = none, 1 = nginx, …)
TRUST_PROXY=0

# ─── Uploads ────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ─── Email (password reset) ─────────────────────────────────
# console = print emails in the server log, resend = send via Resend, none = disabled
EMAIL_PROVIDER=console
EMAIL_FROM=Shadi Hall <no-reply@example.com>
RESEND_API_KEY=

# ─── Jobs ───────────────────────────────────────────────────
SCHEDULER_ENABLED=true
LOG_REQUESTS=true

# ─── Seed (npm run seed) ────────────────────────────────────
SEED_ADMIN_EMAIL=admin@shadihall.pk
SEED_ADMIN_PASSWORD=Admin@12345
